{
  "id": "preferences",
  "type": "ae/preferences",
  "version": "1.0.0",
  "notes": "What sound-cues takes from the preferences component: the PreferencesLike object in cues.ts, whose sound entry says whether sound is on.",
  "operations": {
    "get": {
      "arguments": [
        "name:'sound'"
      ],
      "returns": "boolean"
    },
    "set": {
      "arguments": [
        "name:'sound'",
        "value:boolean"
      ],
      "returns": "void"
    },
    "subscribe": {
      "arguments": [
        "listener:(name,value)=>void"
      ],
      "returns": "()=>void (stop listening)"
    }
  }
}
